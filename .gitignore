# Ignore everything by default; whitelist project files
*
!.gitignore
!README.md
!requirements.txt
!AGENTS.md
!scripts/
!scripts/**
!docs/
!docs/**
!metadata/
!metadata/**
!tests/
!tests/**
!notebooks/
!notebooks/**
!processed/
!processed/reports/
!processed/reports/**

# Common Python ignores (in case new files appear)
__pycache__/
.venv/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.ruff_cache/
.coverage
coverage.xml
.DS_Store

# Explicitly ignore heavy or sensitive CD viewer assets
IMAGES/
IMAGES_ORGANIZED/
HTML/
dicom/
nifti/
*.nii
*.nii.gz
*.zip
*.exe
*.dll
*.pkg
*.msi
*.iso
Help.pdf
DICOMDIR
*.ini

